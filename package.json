{
  "name": "@huatalk/threadloom",
  "version": "0.1.0",
  "description": "Portable agent collaboration plugin: rewind, hide, handoff, roundtable, leader routing, and project memory.",
  "type": "module",
  "bin": {
    "threadloom": "bin/threadloom.mjs"
  },
  "files": [
